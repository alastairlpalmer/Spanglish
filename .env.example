# --- Server ---
# Anthropic API key. When unset (or AI_MOCK=1), the server serves mock AI responses.
ANTHROPIC_API_KEY=

# Supabase project. When unset, server runs without durable ai_calls logging
# and accepts the dev bearer token for auth.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# JWT secret from Supabase dashboard (Settings -> API -> JWT Secret).
# Used to verify user tokens locally without a network round-trip.
SUPABASE_JWT_SECRET=

# Hard daily cap on total tokens across all AI calls. Exceeding it returns a
# clean "paused" error until the next UTC day.
DAILY_TOKEN_BUDGET=2000000

# Force mock AI responses even when a key is present.
AI_MOCK=1

PORT=3000

# --- Client (Vite; set in client/.env.local or Railway build vars) ---
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# VITE_LOCAL_MODE=1   # skip auth + sync, fixed local user (dev without Supabase)

# --- Server ---
# Anthropic API key. When unset (or AI_MOCK=1), the server serves mock AI responses.
ANTHROPIC_API_KEY=

# Postgres connection string (Railway Postgres: reference ${{Postgres.DATABASE_URL}}).
# When unset, the server runs without durability — sync endpoints return 503
# and the client stays purely local. Schema is applied automatically at boot.
DATABASE_URL=

# Single-user auth. APP_PASSCODE is what you type on the sign-in screen;
# AUTH_SECRET signs the session token (any long random string).
# When either is unset, the server runs in dev mode and accepts `Bearer dev`.
APP_PASSCODE=
AUTH_SECRET=

# Hard daily cap on total tokens across all AI calls. Exceeding it returns a
# clean "paused" error until the next UTC day.
DAILY_TOKEN_BUDGET=2000000

# Force mock AI responses even when a key is present.
AI_MOCK=1

PORT=3000

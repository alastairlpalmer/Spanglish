{
  "name": "@seiscientas/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:fastify --external:@fastify/static --external:zod --external:@anthropic-ai/sdk --external:pg --external:jose --external:dotenv",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.60.0",
    "@fastify/static": "^8.0.0",
    "@seiscientas/shared": "*",
    "dotenv": "^16.4.0",
    "fastify": "^5.0.0",
    "jose": "^5.9.0",
    "pg": "^8.13.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0"
  }
}
